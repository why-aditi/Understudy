# Copy to .env (gitignored) and fill in. Both tiers are free and require no credit card.
# Keep the Gemini project billing-disabled: enabling billing deletes its free tier.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides. Defaults are the free-tier models in src/cua/llm/.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
